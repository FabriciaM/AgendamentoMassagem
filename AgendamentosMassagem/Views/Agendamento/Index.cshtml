@model IEnumerable<AgendamentosMassagem.Models.Agendamento>

@{
    ViewData["Title"] = "Agendamentos";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1>Agendamentos</h1>
            <p class="text-muted">
                Consulte, edite ou exclua seus agendamentos.
            </p>
        </div>

        <a asp-action="Create"
               class="btn btn-primary">
            Novo agendamento
        </a>
    </div>

    <!-- Filtros por mês e ano -->
    <form asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <label for="mes"
                   class="form-label">
                Mês
            </label>

            <select name="mes"
                    id="mes"
                    class="form-select">

                <option value="">
                    Todos os meses
                </option>

                <option value="1"
                        selected="@(ViewBag.MesSelecionado == 1)">
                    Janeiro
                </option>

                <option value="2"
                        selected="@(ViewBag.MesSelecionado == 2)">
                    Fevereiro
                </option>

                <option value="3"
                        selected="@(ViewBag.MesSelecionado == 3)">
                    Março
                </option>

                <option value="4"
                        selected="@(ViewBag.MesSelecionado == 4)">
                    Abril
                </option>

                <option value="5"
                        selected="@(ViewBag.MesSelecionado == 5)">
                    Maio
                </option>

                <option value="6"
                        selected="@(ViewBag.MesSelecionado == 6)">
                    Junho
                </option>

                <option value="7"
                        selected="@(ViewBag.MesSelecionado == 7)">
                    Julho
                </option>

                <option value="8"
                        selected="@(ViewBag.MesSelecionado == 8)">
                    Agosto
                </option>

                <option value="9"
                        selected="@(ViewBag.MesSelecionado == 9)">
                    Setembro
                </option>

                <option value="10"
                        selected="@(ViewBag.MesSelecionado == 10)">
                    Outubro
                </option>

                <option value="11"
                        selected="@(ViewBag.MesSelecionado == 11)">
                    Novembro
                </option>

                <option value="12"
                        selected="@(ViewBag.MesSelecionado == 12)">
                    Dezembro
                </option>

            </select>
        </div>

        <div class="col-12 col-md-4">
            <label for="ano"
                   class="form-label">
                Ano
            </label>

            <select name="ano"
                    id="ano"
                    class="form-select">

                <option value="">
                    Todos os anos
                </option>

                <option value="2025"
                        selected="@(ViewBag.AnoSelecionado == 2025)">
                    2025
                </option>

                <option value="2026"
                        selected="@(ViewBag.AnoSelecionado == 2026)">
                    2026
                </option>

                <option value="2027"
                        selected="@(ViewBag.AnoSelecionado == 2027)">
                    2027
                </option>

                <option value="2028"
                        selected="@(ViewBag.AnoSelecionado == 2028)">
                    2028
                </option>

            </select>
        </div>

        <div class="col-12 col-md-4 d-flex align-items-end gap-2">
            <button type="submit"
                    class="btn btn-dark">
                Filtrar
            </button>

            <a asp-action="Index"
                   class="btn btn-secondary">
                Limpar
            </a>
        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            Nenhum agendamento encontrado para o filtro selecionado.
        </div>
    }
    else
    {
        <!-- Tabela responsiva -->
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Tipo de massagem</th>
                        <th>Data</th>
                        <th>Horário</th>
                        <th>Preço</th>
                        <th>Endereço</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.Cliente
                            </td>

                            <td>
                                @item.TipoMassagem
                            </td>

                            <td>
                                @item.DataAgendamento.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @item.HorarioAgendamento.ToString(@"hh\:mm")
                            </td>

                            <td>
                                @item.Preco.ToString("C")
                            </td>

                            <td>
                                @item.Endereco
                            </td>

                            <td class="text-nowrap">
                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                    Detalhes
                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>

<style>
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    table {
        min-width: 950px;
    }

    .text-nowrap {
        white-space: nowrap;
    }

    @@media (max-width: 576px) {
        h1 {
            font-size: 28px;
        }

        .btn {
            margin-bottom: 4px;
        }

        .table {
            font-size: 14px;
        }

        .table th,
        .table td {
            padding: 10px 8px;
        }
    }
</style>
